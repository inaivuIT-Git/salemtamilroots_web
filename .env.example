# Base URL of the Salem Tamil Roots API (no trailing slash).
# UAT:        https://uat.salemtamilroots.in
# Production: https://salemtamilroots.in
API_BASE_URL=https://uat.salemtamilroots.in

# Public site address, used for canonical links and the sitemap.
SITE_URL=https://uat.salemtamilroots.in

# Local development only: 1 = use the clearly labelled sample data in src/lib/sample-data.ts
# instead of calling the API. Never set this on UAT or production.
USE_SAMPLE_DATA=0

# UAT only: 1 = show the "switch to legacy" pill. nginx must have the /switch-ui/ locations
# from deploy/uat/nginx-uat.salemtamilroots.in.conf. Read at build time.
NEXT_PUBLIC_UI_SWITCH=0

# Address the Next.js server uses to call the API. On the VPS: the API directly, e.g.
# http://127.0.0.1:5001 (UAT) or http://127.0.0.1:5000 (production). Empty = API_BASE_URL.
API_INTERNAL_URL=
