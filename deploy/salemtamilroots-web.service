# /etc/systemd/system/salemtamilroots-web.service  (PRODUCTION, later; UAT uses deploy/uat/)
[Unit]
Description=Salem Tamil Roots storefront (Next.js)
After=network.target

[Service]
WorkingDirectory=/opt/salemtamilroots/salemtamilroots_web
ExecStart=/usr/bin/env node node_modules/next/dist/bin/next start --hostname localhost --port 3101
Restart=always
RestartSec=5
User=www-data
Environment=NODE_ENV=production
# The app binds "localhost". Resolve it to 127.0.0.1 (not ::1) so nginx finds it at 127.0.0.1:3101.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/opt/salemtamilroots/salemtamilroots_web/.env.production.local

[Install]
WantedBy=multi-user.target
