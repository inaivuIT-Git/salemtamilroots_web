# Copy to /opt/uat/salemtamilroots_web/.env.production.local on the VPS
API_BASE_URL=https://uat.salemtamilroots.in
SITE_URL=https://uat.salemtamilroots.in
USE_SAMPLE_DATA=0
NEXT_PUBLIC_UI_SWITCH=1
API_INTERNAL_URL=http://127.0.0.1:5001
# MSG91 OTP widget for sign-in: the same widgetId / tokenAuth as MSG91_CONFIG in the current
# frontend's assets/js/common/config.js. Read at build time (NEXT_PUBLIC_), so rebuild after changing.
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
